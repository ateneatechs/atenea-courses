# ───────────────────────────────────────────────────────────────
# Local development
# ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://atenea:atenea_pass@localhost:5432/atenea_courses
JWT_SECRET=your-super-secret-jwt-key-change-this
FRONTEND_URL=http://localhost:5173

# Public base URL of the backend (used for Mercado Pago webhook callbacks).
BACKEND_PUBLIC_URL=http://localhost:3000

# Frontend (Vite) — only used in dev when running `npm run dev`.
VITE_API_URL=http://localhost:3000/api

# ───────────────────────────────────────────────────────────────
# Production deploy (docker-compose.prod.yml) — set these on the VPS
# ───────────────────────────────────────────────────────────────
# Your domain (no protocol). Used to build the HTTPS URLs for payments.
DOMAIN=nazabarber.com

# Tenant slug baked into the frontend build (matches the slug in the database).
DEFAULT_TENANT=naza-barber

# Postgres password for the production database.
POSTGRES_PASSWORD=change-me-strong-password

# Optional global Mercado Pago access token. Leave empty and load the token
# per-academy from the admin panel (Admin → Pagos) instead.
MP_ACCESS_TOKEN=
